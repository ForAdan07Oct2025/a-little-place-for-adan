
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Adan 🌷</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap');

:root {
  --pink: #f6b8d0;
  --lavender: #c9b8ff;
  --cream: #fff0e8;
  --bg: #100d1b;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  color: var(--cream);
  background:
    radial-gradient(ellipse at 15% 10%, #38213e 0%, transparent 45%),
    radial-gradient(ellipse at 85% 60%, #202044 0%, transparent 45%),
    var(--bg);
  font-family: 'DM Sans', sans-serif;
  overflow-x: hidden;
}

#stars, #hearts {
  position: fixed;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}

.star {
  position: absolute;
  width: 3px;
  height: 3px;
  background: white;
  border-radius: 50%;
  animation: twinkle 3s infinite ease-in-out;
}

@keyframes twinkle {
  0%, 100% { opacity: .2; transform: scale(.7); }
  50% { opacity: 1; transform: scale(1.4); }
}

.heart {
  position: absolute;
  bottom: -30px;
  animation: floatUp 9s linear forwards;
  opacity: .65;
}

@keyframes floatUp {
  to { transform: translateY(-110vh) rotate(30deg); opacity: 0; }
}

main {
  position: relative;
  z-index: 1;
}

section {
  min-height: 90vh;
  padding: 100px 22px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.hero { min-height: 100vh; }

.eyebrow {
  color: var(--pink);
  letter-spacing: 4px;
  text-transform: uppercase;
  font-size: 11px;
}

h1, h2 {
  font-family: 'Playfair Display', serif;
  font-weight: 500;
}

h1 {
  font-size: clamp(42px, 9vw, 82px);
  line-height: 1.12;
  margin: 25px 0;
}

h2 {
  font-size: clamp(32px, 6vw, 52px);
  margin: 15px 0;
}

.glow {
  color: var(--pink);
  text-shadow: 0 0 35px #f6b8d080;
}

p {
  color: #ded5e8;
  line-height: 1.9;
  max-width: 600px;
  font-size: 15px;
}

button, .button {
  border: 1px solid #f6b8d080;
  border-radius: 50px;
  padding: 14px 25px;
  color: var(--cream);
  background: #ffffff0b;
  font: inherit;
  cursor: pointer;
  text-decoration: none;
  transition: .3s;
  backdrop-filter: blur(10px);
}

button:hover, .button:hover {
  background: #f6b8d025;
  transform: translateY(-3px);
  box-shadow: 0 0 30px #f6b8d025;
}

.scroll {
  margin-top: 60px;
  color: #b7a7c8;
  font-size: 12px;
  animation: bob 2s infinite;
}

@keyframes bob {
  50% { transform: translateY(8px); }
}

.card {
  width: min(100%, 650px);
  padding: 35px 28px;
  border: 1px solid #ffffff18;
  border-radius: 24px;
  background: #ffffff08;
  backdrop-filter: blur(12px);
  box-shadow: 0 20px 80px #00000020;
}

.letter {
  text-align: left;
  font-family: 'Playfair Display', serif;
  font-size: 18px;
  line-height: 2;
}

.letter p { font-size: 17px; }

.reveal {
  opacity: 0;
  transform: translateY(30px);
  transition: opacity .9s ease, transform .9s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

.lock-icon { font-size: 45px; margin-bottom: 10px; }

input {
  display: block;
  width: min(100%, 330px);
  margin: 20px auto 12px;
  padding: 14px 18px;
  border-radius: 50px;
  border: 1px solid #ffffff30;
  outline: none;
  background: #ffffff0b;
  color: white;
  text-align: center;
  font: inherit;
}

input:focus { border-color: var(--pink); }

#secret { display: none; }

#secret.open {
  display: flex;
  animation: appear 1s ease both;
}

@keyframes appear {
  from { opacity: 0; transform: translateY(25px); }
  to { opacity: 1; transform: translateY(0); }
}

#error {
  min-height: 22px;
  color: #ffb5c8;
  font-size: 13px;
}

footer {
  padding: 40px 20px;
  text-align: center;
  color: #a99ab8;
  font-size: 12px;
}

@media (max-width: 500px) {
  section { padding: 75px 18px; }
  .card { padding: 27px 20px; }
  .letter { font-size: 16px; }
}
</style>
</head>

<body>
<div id="stars"></div>
<div id="hearts"></div>

<main>
  <section class="hero">
    <div class="eyebrow">A little place made just for you</div>
    <h1>For my dear<br><span class="glow">Adan 🌷</span></h1>
    <p>Jab duniya thori mushkil lage,<br>yahan aa kar thora sa sukoon le lena.</p>
    <a href="#letter" class="button">A little something for you ↓</a>
    <div class="scroll">scroll slowly ✨</div>
  </section>

  <section id="letter">
    <div class="reveal">
      <div class="eyebrow">A little reminder</div>
      <h2>You matter. Always. 💗</h2>
      <div class="card letter">
        <p>Adan, meri pyari bhn ❤️</p>
        <p>
          Pta ha, kabhi kabhi zindagi mein itni sari baatein
          ek sath ho jati hain ke dil bht thak jata ha.
          Lekin tumhe har waqt sab kuch sambhalna zaroori nahi.
        </p>
        <p>
          Thora araam kar lena, apna khayal rakhna,
          aur yaad rakhna ke tumhari khushi bht important ha.
          Tumhari muskurahat tumhari pareshaniyon se kahin zyada pyari ha.
        </p>
        <p>
          Phone paas ho ya na ho, achi yaadein aur apne log
          dil ke paas rehte hain. Ye waqt bhi guzar jayega,
          InshaAllah. 🌸
        </p>
        <p>Khud pe thora sa reham karna, meri bhn. 🫂</p>
      </div>
    </div>
  </section>

  <section>
    <div class="reveal">
      <div class="eyebrow">For the days you feel alone</div>
      <h2>Little reminders 🌙</h2>
      <div class="card">
        <p>🌷 Tumhari feelings matter karti hain.</p>
        <p>✨ Tumhe har waqt strong rehna zaroori nahi.</p>
        <p>🫶 Tumhari value kisi phone ya message se decide nahi hoti.</p>
        <p>🌸 Aaj bas apna khayal rakhna bhi kaafi ha.</p>
        <p>💗 Tumhari zindagi mein abhi boht si achi cheezein aani hain.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="reveal">
      <div class="eyebrow">One tiny request</div>
      <h2>Can you smile for me? 😊</h2>
      <p>
        Bas ek choti si smile. Tumhari smile duniya ki
        sari pareshaniyan khatam na bhi kare, phir bhi
        tumhare din ko thora behtar bana sakti ha.
      </p>
      <button onclick="makeHearts()">Send some love 💕</button>
    </div>
  </section>

  <section id="locked">
    <div class="reveal">
      <div class="lock-icon">🔐</div>
      <div class="eyebrow">A little secret, just for you</div>
      <h2>Something special</h2>
      <p>Is choti si jagah ka password sirf tumhe bataya jayega. 💌</p>
      <input id="password" type="password" placeholder="Enter your secret password">
      <button onclick="unlock()">Unlock my surprise ♡</button>
      <div id="error"></div>
    </div>
  </section>

  <section id="secret">
    <div class="card">
      <div class="eyebrow">You found your little surprise</div>
      <h2 class="glow">Adan, you're precious. 💗</h2>
      <p>
        Tum jaisi ho, bht achi ho. Tumhari kindness,
        tumhara caring nature aur tumhari choti choti baatein
        tumhe boht special banati hain.
      </p>
      <p>
        Jab dobara phone mile aur tum ye parho,
        to bas yaad rakhna: tumhari dosti mere liye
        bht meaningful ha. Apna khayal rakhna,
        aur hamesha khush rehne ki koshish karna. 🌷
      </p>
      <p>— Tumhara dost ❤️</p>
    </div>
  </section>

  <footer>Made with care, just for Adan 🌷</footer>
</main>

<script>
  // Twinkling stars
  const stars = document.getElementById('stars');
  for (let i = 0; i < 90; i++) {
    const star = document.createElement('span');
    star.className = 'star';
    star.style.left = Math.random() * 100 + '%';
    star.style.top = Math.random() * 100 + '%';
    star.style.animationDelay = Math.random() * 3 + 's';
    stars.appendChild(star);
  }

  // Reveal sections on scroll
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // Floating hearts
  function makeHearts() {
    const container = document.getElementById('hearts');
    for (let i = 0; i < 18; i++) {
      const heart = document.createElement('span');
      heart.className = 'heart';
      heart.textContent = ['💗', '💕', '🌸', '✨'][Math.floor(Math.random() * 4)];
      heart.style.left = Math.random() * 100 + '%';
      heart.style.fontSize = (16 + Math.random() * 20) + 'px';
      heart.style.animationDuration = (5 + Math.random() * 5) + 's';
      container.appendChild(heart);
      setTimeout(() => heart.remove(), 10000);
    }
  }

  // Password gate
  function unlock() {
    const entered = document.getElementById('password').value;
    const correct = 'Meri jaan Adan ❤️';

    if (entered === correct) {
      document.getElementById('secret').classList.add('open');
      document.getElementById('error').textContent = '';
      document.getElementById('password').value = '';
      document.getElementById('secret').scrollIntoView({ behavior: 'smooth' });
      makeHearts();
    } else {
      document.getElementById('error').textContent =
        'Password sahi nahi ha, dobara try kro 💗';
    }
  }

  document.getElementById('password').addEventListener('keydown', e => {
    if (e.key === 'Enter') unlock();
  });
</script>
</body>
</html>
